# Copie para .env.cloud (ignorado pelo git) e use em: reflex deploy
# SOMENTE valores que podem ficar no painel da nuvem. Nunca coloque aqui
# XANO_TEST_*, senhas ou tokens pessoais.

# URL pública do grupo de API Gestão Hospitalar no Xano.
XANO_API_URL=https://SEU-ENDERECO.xano.io/api:SEU-GRUPO

# Endereço(s) do app publicado, separados por vírgula (ou * no primeiro teste).
GESTAO_CORS_ORIGINS=*

# Logs na saída padrão (a nuvem não tem disco para guardar arquivo).
GESTAO_LOG_FILE=-
GESTAO_LOG_LEVEL=INFO

# Controle de requisições ao Xano (ajuste ao plano do Xano).
XANO_TIMEOUT_SECONDS=10
XANO_MAX_TENTATIVAS=3
XANO_LIMITE_REQUISICOES=8
XANO_JANELA_SEGUNDOS=20
